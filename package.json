{
  "name": "@ilokesto/fetcher",
  "version": "1.0.4",
  "description": "Thin, OpenAPI-aware facade over ky that preserves ky's runtime ergonomics.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "fetch",
    "ky",
    "openapi",
    "typescript",
    "http-client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/fetcher.git"
  },
  "homepage": "https://github.com/ilokesto/fetcher",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "test:dist": "node ./scripts/verify-dist.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "docs:prepare": "pnpm build",
    "docs:dev": "pnpm docs:prepare && pnpm --dir website dev",
    "docs:build": "pnpm docs:prepare && pnpm --dir website build",
    "docs:typecheck": "pnpm docs:prepare && pnpm --dir website typecheck",
    "docs:test": "pnpm --dir website test",
    "docs:start": "pnpm --dir website start",
    "docs:publication:verify": "node scripts/docs-publication.mjs verify && node scripts/docs-runtime.mjs verify",
    "docs:publication:capture": "node scripts/docs-publication.mjs capture",
    "docs:publication:promote": "node scripts/docs-publication.mjs promote",
    "release:verify": "node scripts/release-verify.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "peerDependencies": {
    "ky": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ky": "1.14.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@changesets/cli": "2.31.1",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@10.17.1"
}
